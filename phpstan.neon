# PHPStan for the PHP scripts and their tests (level max). The generators
# read JSON, so the shapes of their records are named here.
parameters:
    level: max
    paths:
        - scripts
        - tests
    typeAliases:
        BackerEntry: 'array{name: string, url: string|null, logo: string|null, group: string}'
        SponsorRecord: 'array{id: string, name: string, url: string|null, logo: string|null, kind: string, source: list<string>, monthlyUsd: int}'
        RosterEntry: 'array{id: string, name: string, url: string|null, logo: string|null, group: string, kind: string, source: list<string>}'
