---
/*
 * The home page: the name of the site and what this repository holds. The
 * files themselves are under public/ (phalcon/, zephir/, debug/), at the
 * addresses that the other sites load.
 */
import Base from '../layouts/Base.astro';
---

<Base>
    <section class="card">
        <h1>Phalcon Assets</h1>
        <p>
            This repository holds the files that the Phalcon sites share: the design
            tokens and the shared stylesheets, the sponsor and GitHub data, the images,
            logos and icons, and the assets of the Phalcon debug page.
        </p>
    </section>
</Base>
