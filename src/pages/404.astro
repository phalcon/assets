---
/*
 * The page that Cloudflare Pages serves for a path that does not exist.
 */
import Base from '../layouts/Base.astro';
---

<Base title="404 - Page not found">
    <section class="card">
        <h1>404</h1>
        <p>Ooops! Something went wrong.</p>
        <p><a href="/" class="button">Back to the assets</a></p>
        <p>&lt;3 Phalcon Team</p>
    </section>
</Base>
